# Deployment-safe variables only. Never commit real secrets; never put secrets in VITE_* variables.
NODE_ENV=production
# Passenger/cPanel injects PORT automatically; set only for manual `npm run start`.
PORT=3000
HOST=0.0.0.0

# MySQL connection settings (cPanel production database: eugtezmj_fitlytix)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eugtezmj_fitlytix
DB_USER=eugtezmj_fitlytix_user
DB_PASSWORD=replace_with_real_password_in_cpanel_env

# Server-side session signing secret (32+ random characters)
SESSION_SECRET=replace_with_32_byte_random_secret_in_cpanel_env
